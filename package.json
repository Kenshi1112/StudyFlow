{
  "name": "studyflow",
  "version": "0.1.0",
  "description": "StudyFlow - Windows desktop task and progress tracker for students (Electron)",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.studyflow.app",
    "productName": "StudyFlow",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@googleapis/classroom": "^19.1.0",
    "better-sqlite3": "^13.0.3",
    "google-auth-library": "^11.3.2"
  }
}
